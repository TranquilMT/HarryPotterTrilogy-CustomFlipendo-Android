+    State(){Channels[0].Alpha=Channels[0].TargetAlpha=1;}
+    Channel& At(int channel){if(channel<0||size_t(channel)>=Channels.size())throw std::runtime_error("PoA animation channel out of range");return Channels[channel];}
+};
